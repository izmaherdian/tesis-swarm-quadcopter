  <diagram name="Arsitektur EKF" id="EKF_Architecture_Page3">
    <mxGraphModel dx="1885" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ekf_container" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;strokeWidth=2;strokeColor=#d6b656;fillColor=#fff2cc;verticalAlign=top;align=center;spacingTop=10;fontStyle=1;fontSize=17;" value="Extended Kalman Filter (EKF)" vertex="1">
          <mxGeometry height="490" width="370" x="310" y="80" as="geometry" />
        </mxCell>
        <mxCell id="step_predict" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;strokeWidth=1.5;strokeColor=#000000;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=17;" value="&lt;b&gt;1. Tahap Prediksi&lt;/b&gt;&lt;div&gt;&lt;b&gt;(Time Update)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;Predict State (\(\hat{x}_{k|k-1}\))&lt;/div&gt;&lt;div&gt;Predict Covariance (\(P_{k|k-1}\))&lt;/div&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;\(f(\cdot), F_{k-1}\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="250" x="350" y="125" as="geometry" />
        </mxCell>
        <mxCell id="step_update" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;strokeWidth=1.5;strokeColor=#000000;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=17;" value="&lt;b&gt;2. Tahap Pembaruan&lt;/b&gt;&lt;div&gt;&lt;b&gt;(Measurement Update)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;Calculate Kalman Gain (\(K_k\))&lt;/div&gt;&lt;div&gt;Update State (\(\hat{x}_{k|k}\))&lt;/div&gt;&lt;div&gt;Update Covariance (\(P_{k|k}\))&lt;/div&gt;&lt;div style=&quot;margin-top: 6px;&quot;&gt;\(h(\cdot), H_k, K_k\)&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="250" x="350" y="355" as="geometry" />
        </mxCell>
        <mxCell id="delay_block" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;strokeWidth=1.5;strokeColor=#000000;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=17;fontStyle=2;" value="k - 1" vertex="1">
          <mxGeometry height="26" width="36" x="615" y="305" as="geometry" />
        </mxCell>
        <mxCell id="input_control" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;strokeWidth=1.5;strokeColor=#000000;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=17;" value="&lt;div&gt;Input Kontrol&lt;/div&gt;&lt;div&gt;(\(u_{k-1}\))&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="160" x="85" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sensor_imu" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;strokeWidth=1.5;strokeColor=#000000;fillColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=17;" value="&lt;div&gt;Sensor Internal&lt;/div&gt;&lt;div&gt;(IMU)&lt;/div&gt;&lt;div&gt;(Accelerometer,&lt;br&gt;Gyroscope)&lt;/div&gt;" vertex="1">
