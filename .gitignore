# ── Artefak build LaTeX (selalu bisa dibuat ulang: `make`) ──────────────
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.synctex(busy)
*.toc
*.xdv
*.run.xml
*.bcf
*.nav
*.snm
*.vrb

# PDF hasil kompilasi — sumbernya .tex, bukan PDF-nya.
# Kirim PDF ke pembimbing lewat ekspor manual, bukan lewat git.
tulisan/**/main.pdf

# ── Python / simulasi ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ── Hasil eksperimen berukuran besar ───────────────────────────────────
# results/ berisi output run. Yang di-commit hanya ringkasan & metrik
# (*.md, *.csv, *.json); data mentah & video diabaikan.
results/**/*.mp4
results/**/*.avi
results/**/*.npz
results/**/*.pkl
results/**/raw/

# ── Sampah OS & editor ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ── Simulator eksternal ────────────────────────────────────────────────
# MultiAgentSim di-clone ke sini, TIDAK dijadikan submodule: repo itu 481 MB
# (Documentation/ memuat PPTX 80 MB + PDF 17 MB), sehingga submodule akan
# memaksa setiap clone repo tesis ikut mengunduh semuanya.
# Versi yang dipakai dikunci di src/MultiAgentSim.version (ikut di-commit).
src/MultiAgentSim/
